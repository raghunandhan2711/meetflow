# Copy this file to .env. Keys stay on the backend.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Local faster-Whisper works without an API key after preparing the model.
# Use groq instead if you prefer hosted transcription with the same Groq key.
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=base
HF_TOKEN=
DIARIZATION_ENABLED=false
# Fresh installations can use SQLite; this machine is already using PostgreSQL.
# Alternative PostgreSQL via the included Docker Compose configuration:
# DATABASE_URL=postgresql+psycopg://minutes:minutes@localhost:5432/minutes
DATABASE_URL=sqlite:///./data/meetings.db
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# For scoped Atlassian tokens set the cloud ID; leave empty for unscoped tokens.
JIRA_CLOUD_ID=
# Single-process limits; counters reset on restart. Groq account quotas also apply.
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_ANALYSES_PER_MINUTE=3
RATE_LIMIT_ANALYSES_PER_HOUR=20
GROQ_REQUESTS_PER_MINUTE=3
GROQ_REQUESTS_PER_HOUR=20
